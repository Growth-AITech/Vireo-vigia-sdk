# Copy to onchain/.env and fill in. NEVER commit the real .env.

# Private key of the funded deployer wallet (with or without 0x). Arbitrum One mainnet.
DEPLOYER_PRIVATE_KEY=

# Arbitrum One RPC. Public default works; a private RPC (Alchemy/Infura) is more reliable.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Etherscan v2 API key (works for Arbiscan) — only needed for source verification.
ARBISCAN_API_KEY=

# Optional: override the metadata string baked in at deploy.
AGENT_METADATA=Vireo Vigia v0.1.1 — Aave V3 / Hyperliquid (Arbitrum)
